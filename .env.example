# ===== Doris 连接 =====
#
# DB_HOST 怎么填，取决于后端跑在哪里：
#   - 后端跑在本机（npm run start:dev）    → 127.0.0.1
#   - 后端跑在容器里、Doris 在宿主机      → host.docker.internal（或宿主机内网 IP）
#   - 后端部署到别处、通过公网访问 Doris        → 120.24.248.175
#
DB_HOST=127.0.0.1
DB_PORT=9030
DB_NAME=looom

# 后端运行时账号（只需读写本项目库）
DB_USER=etl_user
DB_PASSWORD=<你的密码>

# 建库建表账号，仅 scripts/setup-doris.sh 用；后端运行时不需要
DB_ROOT_USER=root
DB_ROOT_PASSWORD=<你的密码>

# ===== JWT =====
JWT_SECRET=<随机字符串，建议 openssl rand -hex 32 生成>
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=30d

# ===== AI（OpenAI 兼容协议）=====
#
# 任何兼容 /v1/chat/completions 的服务都能接：
#   OpenAI / DeepSeek / 通义千问 / Moonshot / 本地 vLLM / Ollama ...
# 只需改 AI_BASE_URL / AI_API_KEY / AI_MODEL 三项。
#
# 开发环境默认 mock，返回预置假分析结果，跑通流程不烧钱。
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=60000
AI_ENABLE_CACHE=true

# ===== 服务端口 =====
API_PORT=3000
WEB_PORT=5173

# ===== ETL 脚本的数据库凭据（scripts/*.py 用，后端运行时不需要）=====
#
# 这些**只给 scripts/ 下的 Python ETL 脚本用**，见 scripts/_dsn.py。
# 后端（apps/api）走上面的 DB_* 变量，两套互不影响。
#
# 主机/端口/库名/用户名在 _dsn.py 里有默认值，通常只需设两个密码。
# 密码没有默认值 —— 缺了脚本会明确报错，不会静默连到 localhost。

# PG 源库（爬虫落库，ETL 的数据来源）
PG_PASSWORD=
# PG_HOST=120.76.216.136
# PG_PORT=15432
# PG_DATABASE=amazon_data
# PG_USER=xiezhiyang

# Doris 数仓（ETL 的写入目标）
DORIS_PASSWORD=
# DORIS_HOST=120.24.248.175
# DORIS_PORT=9030
# DORIS_DATABASE=looom
# DORIS_USER=etl_user
